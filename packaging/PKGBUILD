pkgname=inkwell-git
pkgver=0.1.0
pkgrel=1
pkgdesc="GoodNotes-style handwritten notes (Qt6)"
arch=(x86_64 aarch64)
license=(GPL3)
depends=(qt6-base qt6-declarative qt6-svg)
makedepends=(cmake ninja)
source=()
build() { cmake -S "$startdir/.." -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr; cmake --build build; }
package() { DESTDIR="$pkgdir" cmake --install build; }
